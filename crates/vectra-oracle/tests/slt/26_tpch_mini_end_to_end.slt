# 26_tpch_mini_end_to_end.slt — VectraDB M07 sqllogictest suite

statement ok
CREATE TABLE region (r_regionkey BIGINT, r_name VARCHAR)

statement ok
CREATE TABLE nation (n_nationkey BIGINT, n_name VARCHAR, n_regionkey BIGINT)

statement ok
CREATE TABLE customer (c_custkey BIGINT, c_nationkey BIGINT, c_mktsegment VARCHAR, c_acctbal DOUBLE)

statement ok
CREATE TABLE orders (o_orderkey BIGINT, o_custkey BIGINT, o_orderstatus VARCHAR, o_totalprice DOUBLE, o_orderdate VARCHAR)

statement ok
CREATE TABLE lineitem (l_orderkey BIGINT, l_partkey BIGINT, l_quantity BIGINT, l_extendedprice DOUBLE, l_discount DOUBLE, l_tax DOUBLE, l_returnflag VARCHAR, l_linestatus VARCHAR, l_shipdate VARCHAR)

